.<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MaxProtect Store – Acessórios para iPhone</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Montserrat:wght@700;800&display=swap">
<style>
:root{color-scheme:dark;--bg:#08090c;--s:#0f1218;--s2:#171c26;--bd:#232b3a;--tx:#eef2f8;--mu:#97a3b8;--b1:#2c63d6;--b2:#5ea2ff;--sv:#cdd5e2;--hd:rgba(8,9,12,.92);--logo:url(data:image/jpeg;base64,);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--tx);font:16px/1.6 Manrope,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--hd);z-index:30}
h1,h2,h3,.brand{font-family:Montserrat,system-ui,sans-serif;letter-spacing:-.02em}
.w{max-width:1120px;margin:0 auto;padding:0 20px}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--b2);outline-offset:3px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--hd);backdrop-filter:blur(12px);border-bottom:1px solid var(--bd)}
.bar{display:flex;align-items:center;gap:20px;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;margin-right:auto}
.brand b{color:var(--b2)}
.mark{width:44px;height:44px;border-radius:12px;flex:none;background:#0b0b0d var(--logo) -80px -19px/205px auto no-repeat}
nav{display:flex;gap:22px;font-size:15px;color:var(--mu);font-weight:500}
nav a:hover{color:var(--tx)}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
.cartbtn{position:relative;display:flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--bd);border-radius:999px;background:var(--s);font-weight:600;font-size:14px}
.cartbtn i{font-style:normal;min-width:20px;height:20px;border-radius:10px;background:var(--b1);display:grid;place-items:center;font-size:12px;padding:0 6px}
.btn{display:inline-block;padding:13px 24px;border-radius:12px;font-weight:700;background:linear-gradient(135deg,#2c63d6,#4f93f5);box-shadow:0 8px 28px rgba(44,99,214,.35);text-align:center}
.btn.o{background:none;border:1px solid var(--bd);box-shadow:none;color:var(--sv)}
.hero{display:grid;gap:36px;padding:48px 0 64px;align-items:center}
.hero h1{font-size:clamp(34px,6vw,58px);line-height:1.06;font-weight:800;max-width:18ch}
.hero p{color:var(--mu);font-size:18px;max-width:46ch;margin:18px 0 28px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
@media(min-width:820px){.hero{padding:88px 0 96px}}
@media(max-width:700px){nav{display:none}}
section{padding:56px 0;border-top:1px solid var(--bd)}
h2{font-size:clamp(26px,4vw,36px);font-weight:800;margin-bottom:8px}
.sub{color:var(--mu);margin-bottom:24px}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:12px}
.row span,.row label{color:var(--mu);font-size:14px;font-weight:600;margin-right:6px;min-width:78px}
select{font:inherit;font-size:14px;font-weight:600;color:var(--tx);background:var(--s);border:1px solid var(--bd);border-radius:12px;padding:10px 14px;min-width:min(100%,280px);max-width:100%;cursor:pointer}
option,optgroup{background:var(--s);color:var(--tx)}
.chip{padding:8px 15px;border-radius:999px;border:1px solid var(--bd);background:var(--s);color:var(--sv);font-size:14px;font-weight:600}
.chip[aria-pressed=true]{background:var(--b1);border-color:var(--b2);color:#fff}
#grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}
@media(min-width:760px){#grid{grid-template-columns:repeat(4,1fr);gap:18px}}
.card{display:flex;flex-direction:column;background:var(--s);border:1px solid var(--bd);border-radius:16px;overflow:hidden}
.pic{position:relative;aspect-ratio:1;display:grid;place-items:center;background:radial-gradient(circle at 50% 30%,#22345a,#0f1218 72%);color:var(--sv)}
.pic svg{width:44%;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.tag{position:absolute;top:10px;left:10px;background:var(--sv);color:#0b0d12;font-size:12px;font-weight:700;padding:3px 9px;border-radius:999px}
.pic.ph{background:#0b0d12;cursor:zoom-in}.pic img{width:100%;height:100%;object-fit:cover;display:block}.pic img.c{object-fit:contain}
#lb{position:fixed;inset:0;z-index:60;display:grid;place-items:center;background:rgba(0,0,0,.88);padding:calc(env(safe-area-inset-top,0px) + 16px) 16px calc(env(safe-area-inset-bottom,0px) + 16px);cursor:zoom-out}#lb[hidden]{display:none}#lb img{max-width:100%;max-height:100%;border-radius:12px}
.inf{padding:14px;display:flex;flex-direction:column;gap:4px;flex:1}
.inf h3{font-size:15px;line-height:1.3;font-weight:700}
.inf small{color:var(--mu);font-size:13px;line-height:1.4}
.pr{margin-top:auto;padding-top:10px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.pr b{font-size:18px}.pr s{color:var(--mu);font-size:13px}
.add{margin-top:10px;padding:10px;border-radius:10px;background:var(--s2);border:1px solid var(--bd);font-weight:700;font-size:14px}
.add:hover{background:var(--b1)}
.mu{color:var(--mu)}
.ben{display:grid;gap:0;grid-template-columns:1fr}
.ben div{padding:20px 0 20px 18px;border-left:2px solid var(--b1)}
.ben h3{font-size:17px;margin-bottom:4px}.ben p{color:var(--mu);font-size:15px}
@media(min-width:760px){.ben{grid-template-columns:repeat(4,1fr);gap:24px}.ben div{padding:4px 0 4px 18px}}
.ct{background:linear-gradient(135deg,#142447,#0f1218);border:1px solid var(--bd);border-radius:20px;padding:32px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between}
.ct p{color:var(--mu);max-width:44ch}
footer{border-top:1px solid var(--bd);padding:28px 0;color:var(--mu);font-size:14px}
footer .w{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}
#ov{position:fixed;inset:0;background:rgba(0,0,0,.6);opacity:0;pointer-events:none;transition:opacity .25s;z-index:40}
#cart{position:fixed;top:0;right:0;bottom:0;width:min(400px,100%);background:var(--s);border-left:1px solid var(--bd);z-index:50;transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column;padding:calc(env(safe-area-inset-top,0px) + 18px) 18px calc(env(safe-area-inset-bottom,0px) + 18px)}
.open #ov{opacity:1;pointer-events:auto}.open #cart{transform:none}
.ch{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.ch h2{font-size:22px;margin:0}
#items{flex:1;overflow:auto}
.it{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--bd)}
.it div:first-child{flex:1;font-size:14px;font-weight:600}.it small{display:block;color:var(--mu);font-weight:500}
.q{display:flex;align-items:center;gap:8px}
.q button{width:28px;height:28px;border-radius:8px;border:1px solid var(--bd);background:var(--s2)}
.tot{display:flex;justify-content:space-between;font-size:18px;font-weight:800;padding:16px 0}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<header><div class="w bar">
 <a class="brand" href="#"><span class="mark" role="img" aria-label="Logo MaxProtect"></span><span>Max<b>Protect</b></span></a>
 <nav><a href="#produtos">Produtos</a><a href="#vantagens">Vantagens</a><a href="#contato">Contato</a></nav>
 <button class="cartbtn" id="openCart" aria-label="Abrir carrinho">Carrinho <i id="cnt">0</i></button>
</div></header>

<main>
<div class="w hero">
 <div>
  <h1>Proteção máxima para o seu iPhone</h1>
  <p>Capas, películas, carregador e fone escolhidos para durar. Escolha o seu modelo e veja só o que serve nele.</p>
  <div class="cta"><a class="btn" href="#produtos">Ver produtos</a><a class="btn o" id="waTop" href="#" target="_blank" rel="noopener">Falar no WhatsApp</a></div>
 </div>
</div>

<section id="produtos"><div class="w">
 <h2>Produtos</h2>
 <p class="sub">Filtre pelo seu aparelho e pela categoria.</p>
 <div class="row"><label for="mdl">Seu iPhone</label><select id="mdl"></select></div>
 <div class="row"><span>Categoria</span><span id="cats" style="display:contents"></span></div>
 <div id="grid"></div>
</div></section>

<section id="vantagens"><div class="w">
 <h2>Por que comprar aqui</h2><p class="sub">Tudo o que você precisa saber antes de finalizar o pedido.</p>
 <div class="ben">
  <div><h3>Envio rápido</h3><p>Pedidos despachados em até 24 horas úteis.</p></div>
  <div><h3>Garantia de 12 meses</h3><p>Defeito de fabricação? Trocamos sem burocracia.</p></div>
  <div><h3>Pagamento seguro</h3><p>Pix, cartão em até 12x e boleto.</p></div>
  <div><h3>Atendimento humano</h3><p>Tire dúvidas direto pelo WhatsApp.</p></div>
 </div>
</div></section>

<section id="contato"><div class="w"><div class="ct">
 <div><h2>Não achou o seu modelo?</h2><p>Chame a gente no WhatsApp. Separamos a capa ou a película certa para o seu aparelho.</p></div>
 <a class="btn" id="waCta" href="#" target="_blank" rel="noopener">Chamar no WhatsApp</a>
</div></div></section>
</main>

<footer><div class="w"><span>© 2026 MaxProtect Store. Todos os direitos reservados.</span><a href="https://www.instagram.com/maxprotect.store" target="_blank" rel="noopener">Instagram @maxprotect.store</a><span>Atendimento de segunda a sábado, das 9h às 18h</span></div></footer>

<div id="ov"></div>
<div id="lb" hidden><img alt=""></div>
<aside id="cart" aria-label="Carrinho">
 <div class="ch"><h2>Seu carrinho</h2><button id="closeCart" aria-label="Fechar carrinho" style="font-size:26px;line-height:1">×</button></div>
 <div id="items"></div>
 <div class="tot"><span>Total</span><span id="tot">R$ 0,00</span></div>
 <a class="btn" id="co" href="#" target="_blank" rel="noopener">Finalizar pelo WhatsApp</a>
 <p id="hint" class="mu" style="font-size:13px;text-align:center;margin-top:8px;min-height:1.4em"></p>
</aside>

<script>
const WA='5531991158335',QR='https://wa.me/qr/TK5XTHXRXSI6N1';
const SER=[['xr','iPhone XR',['iPhone XR']],['11','Linha iPhone 11',['iPhone 11','iPhone 11 Pro','iPhone 11 Pro Max']],['12','Linha iPhone 12',['iPhone 12 mini','iPhone 12','iPhone 12 Pro','iPhone 12 Pro Max']],['13','Linha iPhone 13',['iPhone 13 mini','iPhone 13','iPhone 13 Pro','iPhone 13 Pro Max']],['14','Linha iPhone 14',['iPhone 14','iPhone 14 Plus','iPhone 14 Pro','iPhone 14 Pro Max']],['15','Linha iPhone 15',['iPhone 15','iPhone 15 Plus','iPhone 15 Pro','iPhone 15 Pro Max']],['16','Linha iPhone 16',['iPhone 16e','iPhone 16','iPhone 16 Plus','iPhone 16 Pro','iPhone 16 Pro Max']],['17','Linha iPhone 17',['iPhone 17','iPhone Air','iPhone 17 Pro','iPhone 17 Pro Max']]];
const IC={
 Capas:'<rect x="22" y="8" width="36" height="64" rx="9"/><rect x="28" y="14" width="15" height="15" rx="4"/><circle cx="35.5" cy="21.5" r="3.5"/>',
 Películas:'<rect x="20" y="8" width="40" height="64" rx="8"/><path d="M30 58 50 22M38 62l12-20"/>',
 Carregadores:'<rect x="24" y="12" width="32" height="40" rx="6"/><path d="M43 20 34 34h8l-4 12 11-16h-8z"/><path d="M34 52v12M46 52v12"/>',
 Cabos:'<path d="M14 62c18 0 10-44 26-44s8 44 26 44"/><rect x="6" y="58" width="12" height="9" rx="2"/><rect x="62" y="58" width="12" height="9" rx="2"/>',
 Suportes:'<circle cx="40" cy="32" r="19"/><circle cx="40" cy="32" r="9"/><path d="M40 51v15M27 68h26"/>'
};
const IMG={"pb": "data:image/jpeg;base64,", "pv": "data:image/jpeg;base64,", "tr": "data:image/jpeg;base64,", "fo": "data:image/jpeg;base64,", "cam": "data:image/jpeg;base64,", "si": "data:image/jpeg;base64,", "mg": "data:image/jpeg;base64,"};
const P=[
 {id:9,n:'Carregador Portátil MagSafe',c:'Carregadores',d:'Magnético, sem fio e portátil',p:49.99,i:'pb',m:'17,16,15,14,13,12'},
 {id:10,n:'Película 3D de Privacidade',c:'Películas',d:'Do iPhone XR ao 17 Pro Max',p:20,i:'pv'},
 {id:11,n:'Capinha Transparente Magnética',c:'Capas',d:'Compatível com MagSafe, do 13 ao 16 Pro Max',p:25,i:'tr',m:'16,15,14,13'},
 {id:12,n:'Fone Bluetooth',c:'Fones',d:'Com case de carregamento e microfone',p:30,i:'fo',f:1},
 {id:13,n:'Proteção de Câmera',c:'Películas',d:'Do iPhone XR ao 17 Pro Max',p:15,t:'3 cores',i:'cam'},
 {id:14,n:'Capinha Silicone Premium',c:'Capas',d:'Macia ao toque, do 13 ao 16 Pro Max',p:18.99,i:'si',m:'16,15,14,13'},
 {id:15,n:'Capinha Magnética Premium',c:'Capas',d:'MagSafe integrado, do 13 ao 16 Pro Max',p:22.99,t:'7 cores',i:'mg',m:'16,15,14,13'},
];
const CATS=['Todos',...new Set(P.map(p=>p.c))];
let cat='Todos',mod='',modName='',cart={},ORDER='';
try{cart=JSON.parse(localStorage.getItem('mp_cart')||'{}')}catch(e){}
const $=s=>document.querySelector(s),R=n=>n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const wa=t=>`https://wa.me/${WA}?text=${encodeURIComponent(t)}`;
$('#waTop').href=QR;
$('#waCta').href=QR;
function chips(){
 $('#cats').innerHTML=CATS.map(c=>`<button class="chip" data-c="${c}" aria-pressed="${c===cat}">${c}</button>`).join('');
}
function grid(){
 const l=P.filter(p=>(cat==='Todos'||p.c===cat)&&(!mod||!p.m||p.m.split(',').includes(mod)));
 $('#grid').innerHTML=l.map(p=>`<article class="card"><div class="pic${p.i?' ph':''}"${p.i?` data-z="${p.i}" role="button" tabindex="0" aria-label="Ampliar imagem: ${p.n}"`:''}>${p.t?`<span class="tag">${p.t}</span>`:''}${p.i?`<img${p.f?' class="c"':''} src="${IMG[p.i]}" alt="${p.n}" loading="lazy">`:`<svg viewBox="0 0 80 80" aria-hidden="true">${IC[p.c]||IC.Capas}</svg>`}</div><div class="inf"><h3>${p.n}</h3><small>${p.d}</small><div class="pr"><b>${R(p.p)}</b>${p.o?`<s>${R(p.o)}</s>`:''}</div><button class="add" data-a="${p.id}">Adicionar ao carrinho</button></div></article>`).join('')||'<p class="mu" style="grid-column:1/-1">Nenhum produto para esse filtro. Chame a gente no WhatsApp que a gente resolve.</p>';
}
function drawCart(){
 let tot=0,cnt=0,msg=['Olá! Quero finalizar este pedido:'];
 const ids=Object.keys(cart).filter(i=>P.some(p=>p.id==i));
 $('#items').innerHTML=ids.length?ids.map(i=>{const p=P.find(x=>x.id==i),q=cart[i];tot+=p.p*q;cnt+=q;msg.push(`${q}x ${p.n} (${R(p.p*q)})`);
  return `<div class="it"><div>${p.n}<small>${R(p.p)}</small></div><div class="q"><button data-d="${i}" aria-label="Diminuir">−</button><span>${q}</span><button data-u="${i}" aria-label="Aumentar">+</button></div></div>`}).join(''):'<p class="mu">Seu carrinho está vazio. Adicione um produto para começar.</p>';
 if(modName)msg.push(`Meu iPhone: ${modName}`);
 msg.push(`Total: ${R(tot)}`);
 $('#cnt').textContent=cnt;$('#tot').textContent=R(tot);
 const co=$('#co');ORDER=msg.join('\n');co.href=cnt?QR:'#';co.style.opacity=cnt?1:.45;co.style.pointerEvents=cnt?'auto':'none';
 try{localStorage.setItem('mp_cart',JSON.stringify(cart))}catch(e){}
}
const tog=o=>document.body.classList.toggle('open',o);
document.addEventListener('click',e=>{
 const t=e.target.closest('button');if(!t)return;
 const D=t.dataset;
 if(D.c){cat=D.c;chips();grid()}
 else if(D.a){cart[D.a]=(cart[D.a]||0)+1;drawCart();t.textContent='Adicionado';setTimeout(()=>t.textContent='Adicionar ao carrinho',1200)}
 else if(D.u){cart[D.u]++;drawCart()}
 else if(D.d){if(--cart[D.d]<1)delete cart[D.d];drawCart()}
 else if(t.id==='openCart')tog(true);
 else if(t.id==='closeCart')tog(false);
});
$('#ov').onclick=()=>tog(false);
document.addEventListener('keydown',e=>{if(e.key==='Escape')tog(false)});
$('#mdl').innerHTML='<option value="">Todos os modelos</option>'+SER.map(([s,g,a])=>`<optgroup label="${g}">${a.map(n=>`<option value="${s}|${n}">${n}</option>`).join('')}</optgroup>`).join('');
$('#mdl').onchange=e=>{const [s,n]=e.target.value.split('|');mod=s||'';modName=n||'';grid();drawCart()};
const lb=$('#lb');
$('#co').addEventListener('click',()=>{const h=$('#hint'),f=()=>h.textContent='Conte os itens do pedido na conversa.';try{navigator.clipboard.writeText(ORDER).then(()=>h.textContent='Pedido copiado. Cole na conversa do WhatsApp.',f)}catch(e){f()}});
document.addEventListener('click',e=>{const z=e.target.closest('[data-z]');if(z){lb.querySelector('img').src=IMG[z.dataset.z];lb.hidden=false}else if(e.target.closest('#lb'))lb.hidden=true});
document.addEventListener('keydown',e=>{if(e.key==='Escape')lb.hidden=true;if((e.key==='Enter'||e.key===' ')&&e.target.dataset&&e.target.dataset.z){e.preventDefault();e.target.click()}});
chips();grid();drawCart();
</script>
</body>
</html>
